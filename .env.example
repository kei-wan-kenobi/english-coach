# Gemini API key — used ONLY by the local token server, never sent to the browser.
GEMINI_API_KEY=your-api-key-here

# Token server port (the browser fetches ephemeral tokens from here).
TOKEN_SERVER_PORT=8787

# Gemini Live model (native audio). Preview — verify the exact id before shipping.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Shared passphrase guarding /api/token.
# Local dev: optional (leave unset for an open localhost server).
# Vercel/production: REQUIRED — the endpoint refuses to serve without it.
# The browser sends it once via https://<app>/?key=<passphrase> (then stored).
APP_ACCESS_KEY=

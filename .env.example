# Gemini API key — used ONLY by the local token server, never sent to the browser.
GEMINI_API_KEY=your-api-key-here

# Token server port (the browser fetches ephemeral tokens from here).
TOKEN_SERVER_PORT=8787

# Gemini Live model (native audio). Preview — verify the exact id before shipping.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
